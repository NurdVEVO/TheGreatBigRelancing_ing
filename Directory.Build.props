<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <!-- Override either value in Directory.Build.local.props or on the command line. -->
    <NuclearOptionReferenceRoot Condition="'$(NuclearOptionReferenceRoot)' == '' and '$(NUCLEAR_OPTION_034_REFERENCE)' != ''">$(NUCLEAR_OPTION_034_REFERENCE)</NuclearOptionReferenceRoot>

    <NuclearOptionRoot Condition="'$(NuclearOptionRoot)' == '' and '$(NUCLEAR_OPTION_ROOT)' != ''">$(NUCLEAR_OPTION_ROOT)</NuclearOptionRoot>
    <BepInExCore>$(NuclearOptionRoot)\BepInEx\core</BepInExCore>

    <!-- Deployment is deliberately opt-in: dotnet build -p:DeployToGame=true -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>

    <!-- HPW Editor is a development tool and is excluded unless explicitly enabled. -->
    <EnableHpwEditor Condition="'$(EnableHpwEditor)' == ''">false</EnableHpwEditor>
  </PropertyGroup>
</Project>
