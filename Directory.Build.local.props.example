<Project>
  <PropertyGroup>
    <!-- Copy this file to Directory.Build.local.props and adjust for your machine. -->
    <NuclearOptionReferenceRoot>D:\Path\To\NuclearOption-0.34-ReferenceAssemblies</NuclearOptionReferenceRoot>
    <NuclearOptionRoot>D:\SteamLibrary\steamapps\common\Nuclear Option</NuclearOptionRoot>
    <!-- Development builds only. Ordinary Release builds still force this off. -->
    <EnableHpwEditor>true</EnableHpwEditor>
  </PropertyGroup>
</Project>
